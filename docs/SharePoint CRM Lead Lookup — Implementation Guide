# SharePoint CRM Lead Lookup — Implementation Guide

This guide explains how to import a SharePoint lead list from Excel into a Manus WebDev project and display a CRM presence badge on every company card. The badge shows a green **View in CRM →** button (opens the SharePoint item in a new tab) or a grey **Not in CRM database** indicator.

---

## Prerequisites

- A Manus WebDev project with the `web-db-user` feature (MySQL database)
- An Excel file exported from SharePoint with at least three columns: **Company**, **Website**, and **ID**
- The SharePoint DispForm base URL for your list, e.g.:
  ```
  https://yourorg.sharepoint.com/sites/YourSite/Lists/YourList/DispForm.aspx?ID=
  ```

---

## Step 1 — Import the Excel File into MySQL

Run this Python script from the sandbox. It auto-detects the column names, creates the `lt_mns_cg_leads` table if it does not exist, and upserts all rows.

```python
#!/usr/bin/env python3
"""
Import SharePoint lead list from Excel into MySQL lt_mns_cg_leads.

Usage:
    SHAREPOINT_LEADS_BASE_URL="https://yourorg.sharepoint.com/.../DispForm.aspx?ID=" \
    python import_sharepoint_leads.py /path/to/leads.xlsx

Options:
    --table   MySQL table name (default: lt_mns_cg_leads)
    --sheet   Sheet index or name (default: 0)
    --base-url  Overrides SHAREPOINT_LEADS_BASE_URL env var
"""
import argparse, os, re, sys

def extract_domain(url):
    if not url: return None
    url = re.sub(r'^https?://', '', str(url).strip())
    url = re.sub(r'^www\.', '', url)
    domain = url.split('/')[0].split(':')[0].strip()
    return domain.lower() if domain else None

def find_col(headers, *candidates):
    lower = [h.lower() if h else '' for h in headers]
    for c in candidates:
        if c.lower() in lower:
            return lower.index(c.lower())
    return None

parser = argparse.ArgumentParser()
parser.add_argument('excel_file')
parser.add_argument('--table', default='lt_mns_cg_leads')
parser.add_argument('--sheet', default=0)
parser.add_argument('--base-url')
args = parser.parse_args()

base_url = args.base_url or os.environ.get('SHAREPOINT_LEADS_BASE_URL', '')
db_url   = os.environ.get('DATABASE_URL', '')
if not base_url: sys.exit("ERROR: Set SHAREPOINT_LEADS_BASE_URL or pass --base-url")
if not db_url:   sys.exit("ERROR: DATABASE_URL not set")

import openpyxl
wb = openpyxl.load_workbook(args.excel_file)
ws = wb[args.sheet] if isinstance(args.sheet, str) else wb.worksheets[int(args.sheet)]
headers = [ws.cell(1, c).value for c in range(1, ws.max_column + 1)]

col_company = find_col(headers, 'company', 'company name', 'naam', 'bedrijf')
col_website = find_col(headers, 'website', 'url', 'web', 'site')
col_id      = find_col(headers, 'id', 'item id', 'sharepoint id')
if col_company is None: sys.exit(f"ERROR: No Company column. Headers: {headers}")
if col_id      is None: sys.exit(f"ERROR: No ID column. Headers: {headers}")

rows, skipped = [], 0
for r in range(2, ws.max_row + 1):
    company = ws.cell(r, col_company + 1).value
    id_val  = ws.cell(r, col_id      + 1).value
    website = ws.cell(r, col_website + 1).value if col_website is not None else None
    if not company or not id_val:
        skipped += 1; continue
    try: id_int = int(id_val)
    except: skipped += 1; continue
    website_str   = str(website).strip() if website else None
    sharepoint_url = f"{base_url.rstrip('=')}{id_int}" if '=' in base_url else f"{base_url}{id_int}"
    rows.append((id_int, str(company).strip(), website_str, extract_domain(website_str), sharepoint_url))

print(f"Loaded {len(rows)} rows ({skipped} skipped)")

import mysql.connector
from urllib.parse import urlparse
p = urlparse(db_url)
conn = mysql.connector.connect(host=p.hostname, port=p.port or 3306,
    user=p.username, password=p.password, database=p.path.lstrip('/'))
cur = conn.cursor()

cur.execute(f"""
    CREATE TABLE IF NOT EXISTS `{args.table}` (
        id INT PRIMARY KEY,
        company_name TEXT NOT NULL,
        website TEXT,
        domain TEXT,
        sharepoint_url TEXT NOT NULL,
        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    )
""")
conn.commit()

for i in range(0, len(rows), 500):
    batch = rows[i:i+500]
    cur.executemany(
        f"INSERT INTO `{args.table}` (id,company_name,website,domain,sharepoint_url) "
        f"VALUES (%s,%s,%s,%s,%s) ON DUPLICATE KEY UPDATE "
        f"company_name=VALUES(company_name),website=VALUES(website),"
        f"domain=VALUES(domain),sharepoint_url=VALUES(sharepoint_url)",
        batch)
    conn.commit()
    print(f"  Inserted {min(i+500, len(rows))}/{len(rows)}...")

cur.close(); conn.close()
print("Done.")
```

