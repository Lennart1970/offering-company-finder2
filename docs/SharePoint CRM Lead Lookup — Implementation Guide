## Step 4 — Add the tRPC Procedure

In `server/routers.ts`, add to imports:

```ts
import { findCgLead } from "./db";
import { z } from "zod";
```

Add to `appRouter`:

```ts
cgLead: router({
  lookup: publicProcedure
    .input(z.object({
      domain:      z.string().optional(),
      companyName: z.string().optional(),
      websiteUrl:  z.string().optional(),
    }))
    .query(async ({ input }) => {
      // Extract domain from websiteUrl if not provided directly
      let domain = input.domain;
      if (!domain && input.websiteUrl) {
        try {
          const url = new URL(
            input.websiteUrl.startsWith('http') ? input.websiteUrl : `https://${input.websiteUrl}`
          );
          domain = url.hostname.replace(/^www\./, '');
        } catch {}
      }
      const lead = await findCgLead({ domain, companyName: input.companyName });
      return { lead };
    }),
}),
```

